# Скопируйте в .env и подставьте свои значения.
# Файл .env в репозиторий не попадает — он в .gitignore.

# Ключ провайдера моделей. Без него демо работает в режиме заглушки:
# интерфейс и все проверки живые, вместо картинки — placeholder.
AI_API_KEY=

# Адрес API провайдера.
AI_BASE_URL=https://api.aimlapi.com

# Модель генерации изображений.
AI_MODEL=google/nano-banana

# Сколько генераций в час с одного адреса. Демо без авторизации,
# поэтому предел жёсткий.
DEMO_RATE_LIMIT_PER_HOUR=10

# Порт локального сервера.
PORT=8000
